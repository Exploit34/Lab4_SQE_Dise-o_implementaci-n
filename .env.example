# ---- Ambiente (elige config/environments/<TEST_ENV>.json) ----
TEST_ENV=qa

# ---- Secretos (nunca se suben al repositorio) ----
API_TOKEN=
INVALID_TOKEN=invalid_token_123
RESTRICTED_TOKEN=

# ---- Sobrescrituras opcionales (si se omiten se usa el archivo del ambiente) ----
# BASE_URL=https://api.monday.com/v2
# API_VERSION=2025-04
# DELAY_MS=4000
# TIMEOUT_MS=20000

# ---- Logger ----
# LOG_LEVEL=debug            # nivel escrito en logs/ (error | warn | info | debug)
# LOG_CONSOLE_LEVEL=warn     # nivel mostrado en consola

# ---- Capacidades de la cuenta (pon false si la cuenta recibe 403 en esa operación) ----
# CAP_PRIVATE_BOARDS=true
# CAP_UPDATE_BOARD=true
